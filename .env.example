# Copy to .env. Nothing here is required to run the project locally.
#
# There is no model API key in this file, and that is not an omission. Bedrock
# authenticates with the ordinary AWS credential chain - `aws configure`, an SSO
# profile, or a task role - so the credential is administered somewhere a person
# can revoke it, rather than pasted into a dotfile and shared. For a project
# about bounded authority that felt like the wrong place to keep a secret.

# --- AWS --------------------------------------------------------------------
# Only the region and the overrides live here. Credentials come from the chain.
AWS_REGION=us-east-1

# Override the model ids when your region serves them under an inference
# profile prefix (us. / eu. / apac.) instead of the bare id.
# POCKETCHANGE_BEDROCK_MODEL=anthropic.claude-opus-5
# POCKETCHANGE_BEDROCK_JUDGE_MODEL=anthropic.claude-haiku-4-5
# POCKETCHANGE_BEDROCK_REGION=ap-south-1

# Point at DynamoDB Local to run with no AWS account at all:
#   docker compose -f deploy/docker-compose.yml up -d
# POCKETCHANGE_DDB_ENDPOINT=http://localhost:8000
# POCKETCHANGE_DDB_TABLE=pocketchange

# Work entirely offline. The gateway then reports a deterministic decomposer
# and a monitor that cannot judge, rather than implying layers that are absent.
# POCKETCHANGE_NO_BEDROCK=1
# POCKETCHANGE_NO_DYNAMODB=1

# --- the payment rail -------------------------------------------------------
# TEST keys only. Live keys must never appear here; with none set the rail is a
# simulation and /facts reports "rail": "fake" rather than pretending.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- optional ---------------------------------------------------------------
# A fallback chain for when Bedrock throttles. See pocketchange/providers.py.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
